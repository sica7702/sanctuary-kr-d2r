{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanctuary://medium-ai/model-output/v1",
  "title": "Medium AI model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "decision", "confidence", "requires_human_review", "reasons", "tags", "model"],
  "properties": {
    "contract_version": { "const": "medium-body-v1" },
    "decision": { "enum": ["review", "needs_repair", "no_decision"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_human_review": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 40 },
    "mismatch": { "type": ["object", "null"], "additionalProperties": false, "required": ["detected", "fields"], "properties": { "detected": { "type": "boolean" }, "fields": { "type": "array", "items": { "type": "string" } } } },
    "source_snapshot_hash": { "type": ["string", "null"] },
    "model": { "type": "object", "additionalProperties": false, "required": ["provider", "name", "version", "dataset_version"], "properties": { "provider": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" }, "dataset_version": { "type": ["string", "null"] } } }
  }
}
